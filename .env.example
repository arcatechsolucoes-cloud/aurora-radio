# ============ RÁDIO AURORA FM — configuração do painel ============
# Copie este arquivo para ".env" e ajuste os valores antes de publicar.

# Porta HTTP do painel (página + API)
PORT=3000

# Porta do streaming (fonte ao vivo estilo Icecast + ouvintes)
STREAM_PORT=8000

# Endereço público do servidor (ex.: cast.meusite.com.br ou a URL do provedor)
PUBLIC_HOST=localhost

# Diretório de dados (banco JSON + arquivos de áudio).
# Em produção use um volume persistente (veja as instruções de deploy).
DATA_DIR=./data

# Segredo da sessão — TROQUE para uma frase longa e aleatória!
SESSION_SECRET=troque-isto-por-uma-frase-longa-e-aleatoria

# Limite de upload por arquivo (bytes). Default: 200 MB
MAX_UPLOAD_BYTES=209715200

# Intervalo (segundos) de gravação das estatísticas no disco
PERSIST_INTERVAL=30